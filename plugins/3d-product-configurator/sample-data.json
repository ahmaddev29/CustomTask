  "usage_instructions": {
    "materials": {
      "step1": "Copy the materials JSON from the 'data' field above",
      "step2": "Paste into the 'Available Materials' textarea in your product settings", 
      "step3": "Ensure your 3D model materials are named to match the keys (e.g., 'fabric', 'metal')",
      "step4": "Update texture URLs to point to your actual texture files",
      "step5": "Save the product to apply changes"
    },
    "logo_positions": {
      "step1": "Copy the logo positions JSON from the 'data' field above",
      "step2": "Paste into the 'Logo Positions' textarea in your product settings",
      "step3": "Adjust position coordinates based on your 3D model's scale and orientation",
      "step4": "Test positions by uploading a logo in the frontend configurator",
      "step5": "Fine-tune coordinates as needed"
    },
    "coordinate_system": {
      "position": "[x, y, z] where x=left/right, y=up/down, z=forward/back",
      "rotation": "[x, y, z] in radians where Math.PI = 180 degrees",
      "scale": "[x, y, z] where 1.0 = original size, 0.5 = half size, 2.0 = double size"
    }
  },

  "tips": {
    "performance": [
      "Keep texture files under 2MB each for best performance",
      "Use power-of-2 dimensions for textures (512x512, 1024x1024)",
      "Compress textures using tools like TinyPNG or Squoosh",
      "Test on mobile devices to ensure smooth performance"
    ],
    "materials": [
      "Use descriptive material names that match your 3D model",
      "PBR materials work best (metalness + roughness workflow)",
      "Include normal maps for enhanced surface detail",
      "Test materials in different lighting conditions"
    ],
    "logos": [
      "Use high-contrast logos for best visibility",
      "PNG format with transparency works best",
      "Keep logo files under 1MB",
      "Test logo positions on different materials/colors"
    ]
  }
}